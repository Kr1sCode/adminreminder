# Database (SQLite file path)
DATABASE_URL=./ar.db

# JWT secret for sessions - CHANGE THIS IN PRODUCTION!
# In production the app refuses to start with this default. Generate with:
#   openssl rand -base64 48
JWT_SECRET=super-secret-change-me-to-something-long-and-random-please

# Optional: dedicated key for encrypting secrets stored in the settings table
# (SMTP/Resend/Azure/AD passwords). If unset, a key is derived from JWT_SECRET.
# Set this if you ever want to rotate JWT_SECRET without losing stored secrets.
# SETTINGS_KEY=

# Secret for cron jobs (automatic checks + notifications)
# IMPORTANT: Generate a strong random string (e.g. using openssl rand -base64 32)
CRON_SECRET=your-long-random-cron-secret-here

# Public address of this instance, without a trailing slash. Only needed behind
# a reverse proxy that does not forward X-Forwarded-Host/Proto. Used for links
# in notification e-mails.
# APP_ORIGIN=https://ar.twojafirma.pl

# Optional: Microsoft Entra ID (Azure AD) integration.
# When all three are set, AR pulls app registration + service principal
# secrets and certificates from Graph API and monitors their expiry.
#
# Setup: register an app in Entra ID and grant these APPLICATION permissions
# (then "Grant admin consent"), before creating a client secret:
#   Application.Read.All  — app registration secrets & certificates
#   User.Read.All         — user accounts for the directory inventory
#   Domain.Read.All       — password validity policy (to compute expiry)
# These can also be entered in the UI under Settings -> Entra ID.
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=

# Optional: Active Directory (on-prem, LDAP) integration.
# Enables domain login next to local accounts, plus the account/OU inventory.
#
# AD_URL accepts ldap:// or ldaps://. Plain ldap:// sends passwords in
# cleartext, so AR refuses it unless you either turn on StartTLS or explicitly
# accept the risk with AD_ALLOW_INSECURE=true.
# AD_URL=ldaps://dc01.corp.local:636
# AD_START_TLS=false            # upgrade a plain ldap:// connection to TLS
# AD_ALLOW_INSECURE=false       # allow unencrypted ldap:// (passwords in cleartext!)
# AD_TLS_REJECT_UNAUTHORIZED=true   # set false only for a self-signed DC certificate
# AD_CA_CERT_PATH=/etc/ssl/certs/corp-ca.pem   # trust a private CA instead
#
# A plain read-only account is enough; it needs no administrative rights.
# AD_BIND_DN=CN=svc-ar,OU=Service Accounts,DC=corp,DC=local
# AD_BIND_PASSWORD=
# AD_BASE_DN=DC=corp,DC=local
#
# Role mapping. Nested group membership is honoured. Leave both empty to
# disable domain login entirely and use AR only as a directory inventory.
# AD_ADMIN_GROUP_DN=CN=AR-Admins,OU=Groups,DC=corp,DC=local
# AD_VIEWER_GROUP_DN=CN=AR-Viewers,OU=Groups,DC=corp,DC=local
# AD_TIMEOUT_MS=15000

# Optional: Set to production
# NODE_ENV=production
